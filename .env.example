# Copia este archivo a .env y rellena los valores.
# Solo las variables con prefijo VITE_ llegan al frontend (son públicas por diseño).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Credenciales privadas: solo para uso local / CLI / scripts. NUNCA con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
